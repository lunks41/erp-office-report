{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "http://localhost:4000,http://localhost:5000,http://localhost:5003,http://127.0.0.1:4000,http://127.0.0.1:5000,http://127.0.0.1:5003,http://172.16.31.6:81,http://172.16.31.6:84,http://172.16.31.6:4000,http://172.16.31.6:5000,http://172.16.31.6:5003,http://172.16.31.1:4000,http://172.16.31.1:5000,http://172.16.31.208:81"
  },
  "JWT": {
    "ValidAudience": "SecureApiUser",
