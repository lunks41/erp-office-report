<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Offline Telerik .nupkg drop folder (must exist so restore does not fail with NU1301). -->
    <add key="TelerikLocal" value="local-packages" />
  </packageSources>
  <!--
    Optional online Telerik feed (needs credentials in NuGet.config.user):
      <add key="Telerik" value="https://nuget.telerik.com/v3/index.json" protocolVersion="3" />
    See NuGet.config.user.example
  -->
</configuration>
